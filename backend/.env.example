# === RIZEN CARE BACKEND — ENVIRONMENT VARIABLES ===
# Copy this file to .env and fill in your actual API keys

# Server
PORT=5000
NODE_ENV=production

# AI Providers (add any/all - the system cascades through them automatically)
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# CORS - set to your Vercel frontend URL after deploying
ALLOWED_ORIGINS=https://rizenaicare.vercel.app,http://localhost:5173

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
